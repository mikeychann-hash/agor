# ============================================
# Agor Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# Last Updated: November 18, 2025

# -------------------------------------------
# AI Agent API Keys (Required for agentic features)
# -------------------------------------------

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
# Required for: Claude Code sessions
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Required for: Codex sessions
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key
# Get yours at: https://aistudio.google.com/app/apikey
# Required for: Gemini sessions
GEMINI_API_KEY=your-gemini-api-key-here

# -------------------------------------------
# Daemon (Backend) Configuration
# -------------------------------------------

# Daemon server port
# Default: 3030
# Change if port conflicts exist
PORT=3030

# Daemon host binding
# Default: localhost (local development)
# Use 0.0.0.0 for Docker/Codespaces/remote access
# Use 127.0.0.1 for strict localhost-only binding
DAEMON_HOST=localhost

# CORS origin for frontend requests
# Default: auto-computed from UI_PORT
# Production: Set to your frontend domain (e.g., https://agor.example.com)
# Development: http://localhost:5173
# Docker: http://host.docker.internal:5173
# Allow all (not recommended): *
CORS_ORIGIN=http://localhost:5173

# -------------------------------------------
# Database Configuration
# -------------------------------------------

# SQLite database file path
# Default: file:~/.agor/agor.db (user home directory)
# Production: Use absolute path
# Docker: /home/agor/.agor/agor.db
AGOR_DB_PATH=file:~/.agor/agor.db

# Database encryption master secret (CRITICAL SECURITY)
# Default: Auto-generated on first init, stored in ~/.agor/config.yaml
# Production: Set explicitly via environment variable
# IMPORTANT: Keep this secret secure! Used to encrypt API keys in database.
# If not set AND not in production, falls back to plaintext storage (INSECURE)
# Generate with: openssl rand -base64 32
# AGOR_MASTER_SECRET=your-32-character-base64-secret-here

# -------------------------------------------
# UI (Frontend) Configuration
# -------------------------------------------

# UI development server port
# Default: 5173 (Vite default)
UI_PORT=5173

# Daemon URL for UI to connect to (full URL)
# Default: auto-computed from DAEMON_HOST and PORT
# Override for custom configurations
# Examples:
#   - Local: http://localhost:3030
#   - Codespaces: https://{CODESPACE_NAME}-3030.{CODESPACE_LOCATION}.githubpreview.dev
#   - Docker: http://host.docker.internal:3030
#   - Production: https://api.agor.example.com
# VITE_DAEMON_URL=http://localhost:3030

# Daemon port for UI (alternative to VITE_DAEMON_URL)
# Used when VITE_DAEMON_URL is not set
# Default: 3030
VITE_DAEMON_PORT=3030

# GitHub Codespaces flag (auto-detected)
# Set to true when running in GitHub Codespaces
# Auto-detected in most cases - manual override rarely needed
VITE_CODESPACES=false

# -------------------------------------------
# Documentation Site (apps/agor-docs)
# -------------------------------------------

# Google Analytics Measurement ID
# Get yours at: https://analytics.google.com/
# Optional: Leave empty to disable analytics
NEXT_PUBLIC_GA_ID=

# Base path for subdirectory deployments
# Default: empty (deployed at root)
# Example: /docs if deploying to https://example.com/docs
NEXT_PUBLIC_BASE_PATH=

# -------------------------------------------
# Authentication & Security
# -------------------------------------------

# JWT secret for token signing
# Default: Auto-generated on first init, stored in ~/.agor/config.yaml
# Production: Set explicitly via environment variable
# Generate with: openssl rand -base64 64
# JWT_SECRET=your-jwt-secret-here

# Allow anonymous access (no authentication required)
# Default: true (development)
# Production: Set to false to require authentication
# ALLOW_ANONYMOUS=true

# -------------------------------------------
# Development & Testing
# -------------------------------------------

# Node environment
# Options: development | production | test
# Default: development
NODE_ENV=development

# Seed development data on Docker startup
# Options: true | false
# Default: false
# Set to true to populate database with sample data
SEED=false

# Disable Node.js warnings (useful for CLI)
# Options: 0 | 1
# Default: 0 (warnings enabled)
# Set to 1 to suppress experimental feature warnings
NODE_NO_WARNINGS=0

# Enable debug logging
# Options: agor:* | agor:db | agor:api | etc.
# Default: empty (no debug logs)
# Example: agor:* (all debug logs)
# DEBUG=agor:*

# -------------------------------------------
# GitHub Integration (Optional)
# -------------------------------------------

# GitHub Personal Access Token
# Required for: Private repository cloning, GitHub API access
# Get yours at: https://github.com/settings/tokens
# Scopes needed: repo (for private repos), read:org (for org access)
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# -------------------------------------------
# MCP (Model Context Protocol) Servers
# -------------------------------------------
# MCP servers are configured per-session in the UI
# No global environment variables required
# See: Settings > MCP Servers in the Agor UI

# Example: Custom MCP server configuration
# MCP_SERVER_FILESYSTEM_PATH=/path/to/filesystem/server
# MCP_SERVER_GIT_PATH=/path/to/git/server

# -------------------------------------------
# Optional: OpenCode Server Integration
# -------------------------------------------

# OpenCode server URL
# Default: http://localhost:4096
# Only needed if using OpenCode agent
# OPENCODE_SERVER_URL=http://localhost:4096

# -------------------------------------------
# Optional: Advanced Configuration
# -------------------------------------------

# Agor home directory
# Default: ~/.agor
# Override to use different location for config, database, logs
# AGOR_HOME=/path/to/custom/agor/directory

# Disable telemetry (future use)
# Options: true | false
# Default: false
# AGOR_NO_TELEMETRY=false

# Log level
# Options: debug | info | warn | error
# Default: info
# LOG_LEVEL=info

# Maximum WebSocket message size (bytes)
# Default: 1000000 (1MB)
# Increase for large code responses or file contents
# MAX_WEBSOCKET_MESSAGE_SIZE=10000000

# Session timeout (milliseconds)
# Default: 3600000 (1 hour)
# Adjust based on typical session duration
# SESSION_TIMEOUT_MS=3600000

# Rate limiting window (milliseconds)
# Default: 900000 (15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Rate limiting max requests per window
# Default: 1000
# RATE_LIMIT_MAX_REQUESTS=1000

# -------------------------------------------
# Docker-Specific Configuration
# -------------------------------------------

# UID/GID for Docker user
# Default: 1000:1000
# Match your host user UID/GID to avoid permission issues
# DOCKER_UID=1000
# DOCKER_GID=1000

# -------------------------------------------
# Production Deployment Checklist
# -------------------------------------------
# Before deploying to production, ensure:
# ✓ ANTHROPIC_API_KEY set (if using Claude)
# ✓ OPENAI_API_KEY set (if using Codex)
# ✓ GEMINI_API_KEY set (if using Gemini)
# ✓ AGOR_MASTER_SECRET set (generated securely)
# ✓ JWT_SECRET set (generated securely)
# ✓ NODE_ENV=production
# ✓ ALLOW_ANONYMOUS=false (unless intentional)
# ✓ DAEMON_HOST=0.0.0.0 (for Docker/remote)
# ✓ CORS_ORIGIN set to frontend domain
# ✓ VITE_DAEMON_URL set to backend domain
# ✓ Database backup strategy configured
# ✓ SSL/TLS configured (via reverse proxy)
# ✓ Security headers enabled (helmet.js)
# ✓ Rate limiting configured
# ✓ Error tracking configured (Sentry)
# ✓ Log aggregation configured
# ✓ Health monitoring configured

# -------------------------------------------
# Environment-Specific Examples
# -------------------------------------------

# === Local Development ===
# PORT=3030
# DAEMON_HOST=localhost
# UI_PORT=5173
# CORS_ORIGIN=http://localhost:5173
# NODE_ENV=development
# ALLOW_ANONYMOUS=true

# === Docker Development ===
# PORT=3030
# DAEMON_HOST=0.0.0.0
# CORS_ORIGIN=http://host.docker.internal:5173
# SEED=true

# === GitHub Codespaces ===
# PORT=3030
# DAEMON_HOST=0.0.0.0
# VITE_CODESPACES=true
# CORS_ORIGIN=https://{CODESPACE_NAME}-5173.{LOCATION}.githubpreview.dev

# === Production (Docker) ===
# PORT=3030
# DAEMON_HOST=0.0.0.0
# NODE_ENV=production
# ALLOW_ANONYMOUS=false
# CORS_ORIGIN=https://agor.example.com
# VITE_DAEMON_URL=https://api.agor.example.com
# AGOR_MASTER_SECRET={secure-random-secret}
# JWT_SECRET={secure-random-secret}

# -------------------------------------------
# Troubleshooting
# -------------------------------------------

# Issue: "Failed to connect to daemon"
# Solution: Check VITE_DAEMON_URL matches daemon's actual URL
#           In Docker, use host.docker.internal instead of localhost

# Issue: "CORS error"
# Solution: Set CORS_ORIGIN to your frontend's actual origin
#           In development, this is usually http://localhost:5173

# Issue: "API keys stored in plaintext" warning
# Solution: Set AGOR_MASTER_SECRET environment variable
#           Generate with: openssl rand -base64 32

# Issue: "Port already in use"
# Solution: Change PORT or UI_PORT to avoid conflicts
#           Check with: lsof -ti:3030 (daemon) or lsof -ti:5173 (UI)

# Issue: "Database locked" errors
# Solution: Ensure only one daemon instance is running
#           SQLite doesn't support multiple concurrent writers

# Issue: "Permission denied" in Docker
# Solution: Match DOCKER_UID/DOCKER_GID to your host user
#           Or run: chmod -R 777 ~/.agor (not recommended for production)

